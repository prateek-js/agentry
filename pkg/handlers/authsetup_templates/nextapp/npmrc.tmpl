# Created by agentry_auth_setup.
#
# legacy-peer-deps avoids a React 19 RC vs Better-Auth peer-range
# rejection (Better-Auth lists react ^18.0.0 || ^19.0.0; the
# 19.0.0-rc-…-prerelease tags slip through semver but trip npm's
# strict peer check). Safe to leave on — npm 7+ defaults to strict
# peer-dep handling; this flips it back to npm 6's behaviour.
legacy-peer-deps=true
