# Better-Auth — added by agentry_auth_setup.
#
# BETTER_AUTH_SECRET signs session cookies. Rotate per environment;
# the dev value here is fine for localhost but MUST be replaced before
# deploy (the dashboard's env editor is the right place to set the
# production value — never commit prod secrets).
BETTER_AUTH_SECRET={{ .Secret }}

# BETTER_AUTH_URL is intentionally NOT set here. The scaffolded
# src/lib/auth.ts reads the public host from X-Forwarded-Host on
# every request, so preview URLs, deploy URLs, custom domains, and
# self-hosting all work without per-environment config.
#
# Set BETTER_AUTH_URL only if you have a reason to PIN the canonical
# URL — e.g. constructing absolute links in transactional emails.
