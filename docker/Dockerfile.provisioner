# agentry/sandbox-provisioner — runs on the user's machine,
# enrolls with the agentry control plane, and manages sandbox
# containers via the local Docker daemon.
#
# Build:
#   docker buildx build --platform linux/amd64,linux/arm64 \
#       -t ghcr.io/agentry-ai/sandbox-provisioner:latest \
#       -f docker/Dockerfile.provisioner .
#
# Run (the one-liner the dashboard hands to the user):
#   docker run -d --name agentry-provisioner --restart=unless-stopped \
#       --network=host \
#       -v /var/run/docker.sock:/var/run/docker.sock \
#       -v agentry-data:/var/lib/agentry-provisioner \
#       -e AGENTRY_ENROLL_TOKEN=tok_... \
#       -e AGENTRY_CLUSTER_NAME=my-laptop \
#       -e AGENTRY_ENROLL_URL=https://app.agentry.run/api/v1/enroll \
#       ghcr.io/agentry-ai/sandbox-provisioner:latest
#
# Why --network=host: the provisioner has to dial the sandbox runtime
# containers on the host's loopback (the same loopback Docker binds the
# published ports to). Without host networking the provisioner's
# loopback is its own — unreachable from the host's published ports.
# `host.docker.internal` only reaches *bridge-bound* host ports, so if
# the operator has tightened `daemon.json` to bind ports to 127.0.0.1
# (so sandbox runtimes aren't world-reachable), the provisioner inside
# its own netns can't see them at all. Host networking sidesteps both
# concerns at the cost of putting `PROVISIONER_ADDR=:8002` on the
# host — guard that with a host firewall (ufw) in any case.
#
# What the image does at startup:
#
#   1. If /var/lib/agentry-provisioner/cluster.crt exists and is
#      not expired, reuse it. (Restart-safe.)
#   2. Else, hit the control plane's /api/v1/enroll with the env
#      token, persist the returned cert + key + ca.
#   3. Open the mTLS tunnel to the bridge URL from the enroll
#      response.
#   4. Serve the provisioner HTTP API to inbound traffic from the
#      bridge (sandbox create/run/delete/forward/etc).
#
# The image does NOT need root. It does need to talk to the Docker
# daemon — mount /var/run/docker.sock from the host.

FROM golang:1.26-alpine AS builder
WORKDIR /build
# Build version stamped into the provisioner (reported on /api/version,
# compared by the dashboard's update panel). Passed via --build-arg.
ARG PROVISIONER_VERSION=dev
# Cache dep downloads as a separate layer.
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux \
    go build -trimpath -ldflags="-s -w -X main.provisionerVersion=${PROVISIONER_VERSION}" \
    -o /provisioner ./cmd/provisioner && \
    CGO_ENABLED=0 GOOS=linux \
    go build -trimpath -ldflags="-s -w" \
    -o /authproxy ./cmd/authproxy

FROM debian:bookworm-slim
# ca-certificates so HTTPS calls to app.agentry.run / bridge.agentry.run
# verify against public roots. tini gives us proper SIGTERM forwarding.
# tar + gzip to unpack build contexts streamed in from sandboxes. curl
# for fetching railpack + mise at runtime.
#
# Debian (glibc) not alpine (musl): railpack downloads jdx/mise as a
# subprocess, and mise's published linux-x64 binary is glibc-only.
# Running a glibc binary on musl alpine fails with "no such file or
# directory" (the dynamic linker can't be found). Switching the base
# is the lowest-friction fix.
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates tini tar gzip curl \
    && rm -rf /var/lib/apt/lists/*

# Docker CLI — railpack's BUILDKIT_HOST=docker-container://... scheme
# uses `docker exec` to attach to the BuildKit container. Without the
# CLI, railpack fails with "buildkit not reachable". We don't need a
# daemon (the host's daemon is on the bind-mounted socket); just the
# client binary. Static release tarball from download.docker.com keeps
# us off the docker.com apt repo dance.
ARG DOCKER_CLI_VERSION=27.5.1
RUN set -eux; \
    arch="$(uname -m)"; \
    case "$arch" in \
        x86_64)  url="https://download.docker.com/linux/static/stable/x86_64/docker-${DOCKER_CLI_VERSION}.tgz" ;; \
        aarch64) url="https://download.docker.com/linux/static/stable/aarch64/docker-${DOCKER_CLI_VERSION}.tgz" ;; \
        *) echo "unsupported arch: $arch" >&2; exit 1 ;; \
    esac; \
    curl -fsSL "$url" -o /tmp/docker.tgz; \
    tar -xzf /tmp/docker.tgz -C /tmp; \
    install -m 0755 /tmp/docker/docker /usr/local/bin/docker; \
    rm -rf /tmp/docker.tgz /tmp/docker; \
    docker --version

# Railpack — Nixpacks successor, maintained by Railway. Detects the
# project's stack (Node + Vite/Next, Python, Go, Ruby, Rust, …) and
# builds an optimized image via BuildKit. No Dockerfile required from
# the user. The provisioner shells out at deploy-build time.
#
# Pin the version explicitly; bumping is a one-line PR.
ARG RAILPACK_VERSION=v0.25.0
RUN set -eux; \
    arch="$(uname -m)"; \
    case "$arch" in \
        x86_64)  asset="railpack-${RAILPACK_VERSION}-x86_64-unknown-linux-musl.tar.gz" ;; \
        aarch64) asset="railpack-${RAILPACK_VERSION}-arm64-unknown-linux-musl.tar.gz" ;; \
        *) echo "unsupported arch: $arch" >&2; exit 1 ;; \
    esac; \
    curl -fsSL "https://github.com/railwayapp/railpack/releases/download/${RAILPACK_VERSION}/${asset}" \
        -o /tmp/railpack.tgz; \
    tar -xzf /tmp/railpack.tgz -C /tmp; \
    install -m 0755 /tmp/railpack /usr/local/bin/railpack; \
    rm -f /tmp/railpack.tgz /tmp/railpack; \
    railpack --version

# We deliberately do NOT add a `USER` directive — the provisioner runs
# as root inside its container because it needs RW on /var/run/docker.sock,
# which is typically root-owned (uid 0) or root-group-owned on the host.
# Switching to a non-root user with a hard-coded gid would either
# (a) fail when the host's docker.sock gid doesn't match (common; varies
# by distro), or (b) require post-build chown of the socket, which is a
# privileged operation.
#
# The provisioner's blast radius is the host's Docker daemon either way
# — root-in-container = root-on-host for anything that can talk to
# docker.sock. Defense-in-depth lives in the bridge mTLS gate + the
# sandbox container hardening (cap-drop=ALL, no-new-privileges,
# PidsLimit) — those are what stop a sandbox escape from reaching the
# provisioner in the first place.

COPY --from=builder /provisioner /usr/local/bin/agentry-provisioner
# m2: authproxy sidecar binary. deploy_build wraps every deployed
# image with a final layer that COPYs this onto the railpack output,
# then sets ENTRYPOINT to it with AGENTRY_AUTHPROXY_EXEC pinned to
# the image's original CMD/ENTRYPOINT. See pkg/provisioner/deploy_wrap.go.
COPY --from=builder /authproxy /usr/local/share/agentry/authproxy

# Persistent state lands here. Single Docker volume in the run command
# binds to /var/lib/agentry-provisioner; cert bundle + lockfile-like
# state survive container restarts.
ENV AGENTRY_CERT_DIR=/var/lib/agentry-provisioner
ENV PROVISIONER_ADDR=:8002
ENV BACKEND=docker
# NODE_HOST is intentionally NOT set here — pkg/provisioner/config.go
# defaults it to "localhost" for the docker backend, which is the right
# answer for the --network=host deploy posture this image expects.
# Overriding here would override that default even when a fresh deploy
# can't possibly know better.
ENV SANDBOX_IMAGE=ghcr.io/agentry-ai/runtime:latest

EXPOSE 8002

# tini as PID 1 for clean signal handling; the provisioner binary
# does its own enroll-on-first-boot, no separate entrypoint script
# needed.
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/agentry-provisioner"]
